# RepoStory Environment Configuration

# Gemini API Key (Required for live AI lesson generation)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini Model name (Default: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: GitHub Personal Access Token (for increasing GitHub API rate limits from 60 to 5,000 req/hr)
# Not required for basic public repository exploration.
GITHUB_TOKEN=

# Node Environment
NODE_ENV=development
